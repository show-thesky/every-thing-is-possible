{
  "name": "dsh-pierce",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "description": "DSH 破甲 v2：前置改写 + 事后对账 + 可开关的前端面板",
  "main": "plugin/index.js",
  "scripts": {
    "selftest": "node tests/selftest.mjs",
    "panel": "node tests/panel-selftest.mjs",
    "test": "node tests/selftest.mjs && node tests/panel-selftest.mjs",
    "audit": "node auditor/index.mjs",
    "dist": "node build-dist.mjs"
  },
  "engines": {
    "node": ">=24"
  },
  "exports": {
    ".": "./plugin/index.js",
    "./client": "./plugin/client.js",
    "./auditor": "./auditor/index.mjs",
    "./package.json": "./package.json"
  },
  "bin": {
    "pierce-audit": "auditor/index.mjs"
  },
  "files": [
    "plugin",
    "auditor",
    "prompts",
    "cordis.patch.yml",
    "install.mjs",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "slots"
      ]
    }
  }
}
